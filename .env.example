# ==============================================
# Sulfri Trainer Portal - Environment Variables
# ==============================================
# Copy this file to .env.local and fill in the values

# ----- Database (Required) -----
# PostgreSQL connection string
# For Vercel: Use Vercel Postgres, Neon, or Supabase DB
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# Shadow database for Prisma migrations (local dev only)
# SHADOW_DATABASE_URL="postgresql://user:password@host:5432/dbname_shadow?schema=public"

# ----- NextAuth (Required) -----
# Your app's public URL (no trailing slash)
NEXTAUTH_URL="http://localhost:3000"

# Secret key for JWT encryption (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET="generate-a-strong-secret-here"

# ----- Vercel Blob Storage (Required for production file uploads) -----
# Get from: Vercel Dashboard > Storage > Create Blob Store
BLOB_READ_WRITE_TOKEN=""

# ----- Super Admin Setup (used by seed/admin scripts) -----
SUPER_ADMIN_EMAIL="admin@yourdomain.com"
SUPER_ADMIN_PASSWORD="change-this-secure-password"
SUPER_ADMIN_NAME="Admin Name"

# ----- Credly OAuth (Optional - for authenticated badge sync) -----
# Register your app at: https://www.credly.com/oauth/authorizations
# Set callback URL to: https://yourdomain.com/api/credly/oauth/callback
CREDLY_CLIENT_ID=""
CREDLY_CLIENT_SECRET=""
CREDLY_REDIRECT_URI="http://localhost:3000/api/credly/oauth/callback"

# ----- Email Service (Optional - for proposal notifications) -----
# Choose one: Resend (recommended) or SendGrid
# Resend: Get API key from https://resend.com
RESEND_API_KEY=""
# SendGrid: Get API key from https://sendgrid.com
SENDGRID_API_KEY=""
# Email configuration
FROM_EMAIL="noreply@yourdomain.com"
FROM_NAME="MSH Corporate Trainer"
ADMIN_EMAIL="your-email@example.com"
